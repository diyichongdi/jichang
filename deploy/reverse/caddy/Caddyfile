# ============================================================
#  Xboard 面板反代 · Caddy (推荐，自动申请/续期 HTTPS 证书)
#  部署：把 Caddyfile 放到你的 Caddy 容器挂载目录
# ============================================================

xboard.example.com {
    # 反代到面板容器 (127.0.0.1:7001)
    reverse_proxy 127.0.0.1:7001
    encode gzip

    # 订阅接口可能出现大响应，放开限制
    request_body {
        max_size 0
    }
}

# 备用域名(防墙轮换)示例，取消注释即可启用
# xboard-backup.example.com {
#     reverse_proxy 127.0.0.1:7001
# }
