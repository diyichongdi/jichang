# ============================================================
#  Xboard 面板环境变量模板
#  复制为 .env 后填写：cp .env.example .env
#
#  !!! 安全要求 !!!
#  1. 所有密码/密钥必须改成强随机值，不要用默认
#  2. DB_PASSWORD 需与 docker-compose.yml 引用一致
#  3. 通讯密钥(通讯密钥=COMM_MIGRATION)留在面板后台设置
#  4. 本文件含敏感信息，勿提交到 git / 勿泄露
# ============================================================

# ---------- 数据库 (面板安装向导会读取) ----------
DB_PASSWORD="CHANGE_ME_STRONG_DB_PASSWORD"

# ---------- 站点域名 (向导填写) ----------
# APP_URL="https://xboard.example.com"

# ---------- 应用密钥 (安装向导自动生成, 可留空) ----------
# APP_KEY=

# ---------- 时区 ----------
# TZ=Asia/Shanghai

# ---------- 邮件 SMTP (开启邮箱验证防刷库时配置) ----------
# MAIL_HOST=
# MAIL_PORT=465
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_ENCRYPTION=ssl
# MAIL_FROM_ADDRESS=noreply@example.com
# MAIL_FROM_NAME="Xboard"
