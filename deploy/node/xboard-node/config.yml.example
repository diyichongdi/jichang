# ============================================================
#  Xboard-Node 节点后端配置模板
#  Xboard 官方配套后端，集成度高，支持新协议(Reality/Hysteria2)
#  部署目录：/opt/xboard-node ，复制为 config.yml
# ============================================================

panel:
  panel_type: "new_v2board"        # 对接 Xboard
  api_host: "https://xboard.example.com"   # 面板域名
  api_key: "COMM_MIGRATION_KEY_FROM_PANEL" # 面板通讯密钥
  node_id: 1                       # 面板后台节点 ID
  timeout: 30                      # API 请求超时
  enable_log: true

# 多节点模式：填 nodes 后忽略顶部 node_id
# nodes:
#   - node_id: 1
#   - node_id: 2
#     kernel_type: "xray"

kernel:
  type: "sing_box"                 # xray 或 sing_box
  config_dir: "/etc/xboard-node/"

cert:
  auto_tls: true                   # 自动申请/续签证书 (需域名指向本节点)
  domain: "node.example.com"
  # 用 Cloudflare DNS-01 验证时放开下面配置
  # dns_provider: "cloudflare"
  # dns_cloudflare_api_token: "CHANGE_ME"
  # email: "you@example.com"

runtime:
  gomemlimit: ""                   # 内存软限制，可如 "256MiB"
