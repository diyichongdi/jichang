# ============================================================
#  机场全栈站 · 环境变量模板
#  复制为 .env 后填写：cp .env.example .env
# ============================================================

# 运行环境
NODE_ENV=development
PORT=3000
# 后端对外地址(生产必填)
BASE_URL=http://localhost:3000
# 前端落地页地址
WEB_URL=http://localhost:8800

# ---------- 安全 (生产必改) ----------
JWT_SECRET=change_me_long_random_secret
JWT_EXPIRES=7d

# ---------- 邮件(SMTP), 注册验证/找回密码用 ----------
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=you@example.com
MAIL_PASS=your_password
MAIL_FROM=noreply@example.com
MAIL_NAME=AuroraCloud

# ---------- 支付驱动 (预留接口) ----------
# 支付宝当面付/网站支付
ALIPAY_ENABLED=false
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=
ALIPAY_GATEWAY=https://openapi.alipay.com/gateway.do

# USDT 加密支付
USDT_ENABLED=false
USDT_API_URL=
USDT_API_KEY=
USDT_MERCHANT_ID=
USDT_WALLET=

# 易支付(第三方聚合)
EPAY_ENABLED=false
EPAY_API_URL=
EPAY_PID=
EPAY_MERCHANT_KEY=

# ---------- Xboard 面板对接 (开站后填) ----------
XBOARD_API_HOST=
XBOARD_API_KEY=
